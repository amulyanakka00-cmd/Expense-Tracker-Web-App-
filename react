import React, { useState } from "react";
import "./App.css";

function App() {
  const [expenses, setExpenses] = useState([]);
  const [title, setTitle] = useState("");
  const [amount, setAmount] = useState("");
  const [category, setCategory] = useState("");

  const addExpense = () => {
    if (!title || !amount || !category) {
      alert("Please fill all fields!");
      return;
    }

    const newExpense = {
      id: Date.now(),
      title,
      amount: parseFloat(amount),
      category,
    };

    setExpenses([...expenses, newExpense]);
    setTitle("");
    setAmount("");
    setCategory("");
  };

  const deleteExpense = (id) => {
    setExpenses(expenses.filter((exp) => exp.id !== id));
  };

  const total = expenses.reduce((sum, exp) => sum + exp.amount, 0);

  return (
    <div className="min-h-screen bg-gray-100 flex flex-col items-center p-6">
      <h1 className="text-3xl font-bold text-blue-700 mb-6">
        💰 Expense Tracker
      </h1>

      {/* Expense Input Form */}
      <div className="bg-white p-6 rounded-2xl shadow-md w-full max-w-md mb-6">
        <h2 className="text-xl font-semibold mb-4 text-gray-700">Add Expense</h2>

        <input
          type="text"
          placeholder="Expense Title"
          value={title}
          onChange={(e) => setTitle(e.target.value)}
          className="w-full p-2 border rounded-lg mb-3"
        />

        <input
          type="number"
          placeholder="Amount"
          value={amount}
          onChange={(e) => setAmount(e.target.value)}
          className="w-full p-2 border rounded-lg mb-3"
        />

        <input
          type="text"
          placeholder="Category (e.g., Food, Travel)"
          value={category}
          onChange={(e) => setCategory(e.target.value)}
          className="w-full p-2 border rounded-lg mb-3"
        />

        <button
          onClick={addExpense}
          className="bg-blue-600 text-white w-full py-2 rounded-lg hover:bg-blue-700"
        >
          Add Expense
        </button>
      </div>

      {/* Expense List */}
      <div className="bg-white p-6 rounded-2xl shadow-md w-full max-w-md">
        <h2 className="text-xl font-semibold mb-4 text-gray-700">Expense List</h2>

        {expenses.length === 0 ? (
          <p className="text-gray-500">No expenses added yet.</p>
        ) : (
          <ul>
            {expenses.map((exp) => (
              <li
                key={exp.id}
                className="flex justify-between items-center border-b py-2"
              >
                <div>
                  <p className="font-semibold">{exp.title}</p>
                  <p className="text-sm text-gray-500">
                    {exp.category} — ₹{exp.amount}
                  </p>
                </div>
                <button
                  onClick={() => deleteExpense(exp.id)}
                  className="bg-red-500 text-white px-3 py-1 rounded-lg hover:bg-red-600"
                >
                  Delete
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      {/* Total Section */}
      <div className="mt-6 bg-green-100 px-6 py-3 rounded-2xl shadow-md text-lg font-semibold text-green-800">
        Total Spent: ₹{total}
      </div>
    </div>
  );
}

export default App;
